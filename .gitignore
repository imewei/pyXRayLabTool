# ----------------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
coverage.json
*.cover
*.py,cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/
.benchmarks/
# Written by `make claude` / `make perf-report`.
coverage-claude.json
benchmark_report.json
# CI outputs that are only uploaded as artifacts, but appear locally when a
# workflow step is reproduced by hand.
pytest-results.xml
test-results.xml
pip-audit.json
license-report.md
current_dependencies.txt
bandit*re*.json

# ----------------------------------------------------------------------------
# Type checkers, linters & tool caches
# ----------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pylint_cache/
# Anchored: unanchored, `.cache` matches files and directories at any depth.
/.cache/

# ----------------------------------------------------------------------------
# Scientific data & run outputs
# ----------------------------------------------------------------------------
# Arrays and datasets are regenerable or too large to version. The bundled
# CXRO tables are plain-text .nff files and are not affected. If a fixture ever
# needs committing, add a targeted negation next to this block.
*.h5
*.hdf5
*.mat
*.npy
*.npz
# Root-level scratch only: the bare names would match tests/data/results/ etc.
/figures/
/plots/
/output/
/outputs/
/results/
/reports/
jax_cache/

# ----------------------------------------------------------------------------
# Jupyter / IPython
# ----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py
.jupyter/

