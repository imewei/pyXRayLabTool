   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a list of materials for batch processing\n",
    "batch_materials = [\n",
    "    {\"formula\": \"Si\", \"density\": 2.33},\n",
    "    {\"formula\": \"SiO2\", \"density\": 2.20},\n",
    "    {\"formula\": \"Al\", \"density\": 2.70},\n",
