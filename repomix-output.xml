        # Output results
        if args.output:
            output_path = Path(args.output)
            if output_path.suffix.lower() == ".json":
                with open(args.output, "w") as f:
                    json.dump(results, f, indent=2)
            else:  # CSV
                import csv

                if results:
                    with open(args.output, "w", newline="", encoding="utf-8") as f:
