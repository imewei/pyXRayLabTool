        # Test complex arrays
        complex_arr = np.array([1 + 2j, 2 + 3j], dtype=np.complex128)
        assert validate_complex_array(complex_arr) is True

        # Test invalid types
        int_arr = np.array([1, 2, 3], dtype=np.int32)
        assert validate_float_array(int_arr) is False
