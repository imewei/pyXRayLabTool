        n = 1_000_000
        arr = self.b.linspace(0.0, 1.0, n)
        assert len(arr) == n
        assert math.isclose(float(arr[0]), 0.0)
        assert math.isclose(float(arr[-1]), 1.0)
        assert self.b.all(self.b.isfinite(arr))
