    def test_memory_scaling(self):
        """Test memory scaling with problem size."""
        import tracemalloc

        formula = "SiO2"
        density = 2.2
        sizes = [100, 500, 1000]

        for size in sizes:
            energies = np.linspace(5.0, 15.0, size)

