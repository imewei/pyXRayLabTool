            # Benchmark cached access
            start_time = time.perf_counter()
            for _ in range(100):
                (
                    _f1_interp_cached,
                    _f2_interp_cached,
                ) = create_scattering_factor_interpolators(element)
            cached_time = (time.perf_counter() - start_time) / 100

            # Test interpolation speed
